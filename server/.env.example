PORT=5000
FRONTEND_URL=http://localhost:5173

# Razorpay Tech Partner Application Credentials
# Obtain these from: Razorpay Dashboard -> Applications -> OAuth
RAZORPAY_CLIENT_ID=your_partner_client_id_here
RAZORPAY_CLIENT_SECRET=your_partner_client_secret_here

# Redirect URI configured in your Razorpay Application
# NOTE: Razorpay does NOT allow 'localhost'. Use your live domain or free tunnel URL (e.g., localtunnel or ngrok):
# Run `npm run tunnel` to get a free https://*.loca.lt URL
RAZORPAY_REDIRECT_URI=https://your-tunnel-url.loca.lt/api/oauth/callback

# Webhook Secret configured in your Razorpay Application
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Environment mode: 'test' or 'live'
RAZORPAY_MODE=test
